diff --git a/Packages/ApelinAgent/Sources/ApelinAgentWorker/SignIn/EndpointStore.swift b/Packages/ApelinAgent/Sources/ApelinAgentWorker/SignIn/EndpointStore.swift
new file mode 100644
index 0000000..c0415b5
--- /dev/null
+++ b/Packages/ApelinAgent/Sources/ApelinAgentWorker/SignIn/EndpointStore.swift
@@ -0,0 +1,257 @@
+import ApelinAgent
+import ApelinCore
+import ApelinProtocol
+import Foundation
+import KWWKAI
+
+/// An OpenAI-compatible endpoint the reader saved — its name, its address,
+/// the models it serves and, in the keychain, its key.
+///
+/// Endpoints live in the same store as every other sign-in, one store id
+/// each (`CredentialProviderID.endpoint`), so a reader can keep as many
+/// sites as they like and a session names the one it talks to. Nothing here
+/// is a kwwk provider of its own: each endpoint resolves through the same
+/// `openai-compatible` registration, with its base URL in the credential.
+enum EndpointStore {
+    static let titleExtra = "title"
+    static let modelsExtra = "models"
+    /// The context window the reader gave this site. kwwk's endpoint model
+    /// takes 131072 tokens otherwise, which is wrong for a relay serving a
+    /// model that reads less, and idles a model that reads more.
+    static let contextWindowExtra = "contextWindow"
+    /// Whether this site's models take pictures. kwwk hands an endpoint a
+    /// text-only model, so without this a screenshot never leaves the
+    /// device: it is replaced by "(image omitted)" before the request.
+    /// Absent means pictures, which is what a site serving a vision model
+    /// needs and what a reader who saved nothing asked for.
+    static let imagesExtra = "images"
+    /// A reader may keep plenty; the sign-in screen is not a directory.
+    static let maximumEndpoints = 64
+    static let maximumModels = 64
+
+    // MARK: - Reading
+
+    static func summary(id: String, credentials: OAuthCredentials) -> AgentEndpointSummary {
+        AgentEndpointSummary(
+            id: id,
+            title: string(titleExtra, in: credentials) ?? host(credentials) ?? id,
+            baseURL: string(AgentSignInField.baseURL.rawValue, in: credentials) ?? "",
+            defaultModel: string(AgentSignInField.defaultModel.rawValue, in: credentials),
+            models: models(credentials),
+            hasKey: !credentials.access.isEmpty,
+            contextWindow: contextWindow(credentials),
+            images: images(credentials),
+        )
+    }
+
+    /// Whether pictures are sent to this site. Only an endpoint saved with
+    /// them off says no; everything else, including one saved before the
+    /// field existed, is sent them.
+    static func images(_ credentials: OAuthCredentials) -> Bool {
+        string(imagesExtra, in: credentials) != "0"
+    }
+
+    /// The window this endpoint was given, if any. A site keeps it in its
+    /// own extra so the credential still reads as one kwwk stores.
+    static func contextWindow(_ credentials: OAuthCredentials) -> Int? {
+        guard case let .string(value)? = credentials.extras[contextWindowExtra],
+              let tokens = Int(value), tokens >= minimumContextWindow
+        else { return nil }
+        return tokens
+    }
+
+    /// Below this a session cannot hold its system prompt and one turn; the
+    /// floor also keeps a typo from making every request too large.
+    static let minimumContextWindow = 4_096
+    static let maximumContextWindow = 4_000_000
+
+    static func account(id: String, credentials: OAuthCredentials) -> AgentAccount {
+        let summary = summary(id: id, credentials: credentials)
+        var account = AgentAccount(
+            provider: .openAICompatible,
+            id: id,
+            title: summary.title,
+            method: .apiKey,
+            signedIn: true,
+            account: host(credentials),
+            endpoint: summary,
+        )
+        account.models = summary.models
+        account.usesAPIKey = true
+        // A site has no catalogue to say which of its models think, so every
+        // model it lists is offered the levels the wire format speaks and
+        // the site ignores the ones it does not use.
+        account.reasoningEfforts = summary.models.reduce(into: [String: [AgentReasoningEffort]]()) { efforts, model in
+            efforts[model] = ProviderModels.endpointEfforts
+        }
+        return account
+    }
+
+    /// The models saved with the endpoint, in the order the reader put
+    /// them. Empty for a credential that is not an endpoint.
+    static func models(_ credentials: OAuthCredentials) -> [String] {
+        (string(modelsExtra, in: credentials) ?? "")
+            .split(separator: ",")
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { !$0.isEmpty }
+    }
+
+    static func string(_ key: String, in credentials: OAuthCredentials) -> String? {
+        guard case let .string(value)? = credentials.extras[key], !value.isEmpty else { return nil }
+        return value
+    }
+
+    static func host(_ credentials: OAuthCredentials) -> String? {
+        string(AgentSignInField.baseURL.rawValue, in: credentials)
+            .flatMap { URLComponents(string: $0)?.host }
+    }
+
+    // MARK: - Writing
+
+    /// Refuses what a session could never use, naming the field alone.
+    static func validated(
+        _ request: AgentEndpointSaveRequest,
+        existing: OAuthCredentials?,
+    ) throws -> (
+        title: String,
+        baseURL: String,
+        model: String?,
+        models: [String],
+        key: String,
+        contextWindow: Int?,
+        images: Bool
+    ) {
+        let title = request.title.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !title.isEmpty, title.count <= 64 else {
+            throw ApelinError(.badRequest, "Enter a name for this endpoint, 64 characters at most.")
+        }
+        let base = request.baseURL.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard base.count <= 2048, let url = URLComponents(string: base),
+              let scheme = url.scheme?.lowercased(), scheme == "https" || scheme == "http",
+              url.host?.isEmpty == false, url.user == nil, url.password == nil,
+              url.query == nil, url.fragment == nil
+        else {
+            throw ApelinError(.badRequest, "Enter a valid HTTP or HTTPS address.")
+        }
+        let key = (request.apiKey ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+        if key.isEmpty {
+            guard let existing, !existing.access.isEmpty else {
+                throw ApelinError(.badRequest, "Enter the endpoint’s API key.")
+            }
+        } else {
+            guard key.count <= 4096, !key.unicodeScalars.contains(where: isSpaceOrControl) else {
+                throw ApelinError(.badRequest, "Enter a valid API key without spaces or line breaks.")
+            }
+        }
+        var models: [String] = []
+        for model in request.models {
+            let trimmed = model.trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !trimmed.isEmpty, trimmed.count <= 256, !trimmed.contains(where: \.isNewline) else {
+                throw ApelinError(.badRequest, "Enter a valid model ID without spaces or line breaks.")
+            }
+            if !models.contains(trimmed) { models.append(trimmed) }
+        }
+        guard models.count <= maximumModels else {
+            throw ApelinError(.badRequest, "Keep \(maximumModels) models at most on one endpoint.")
+        }
+        let declared = request.defaultModel?.trimmingCharacters(in: .whitespacesAndNewlines)
+        let model = declared?.isEmpty == false ? declared : models.first
+        // A window the reader names is the one the session plans with, so a
+        // number that no session could use is refused here rather than made
+        // to fail a request later.
+        if let window = request.contextWindow {
+            guard (minimumContextWindow ... maximumContextWindow).contains(window) else {
+                throw ApelinError(
+                    .badRequest,
+                    "Enter a context window from \(minimumContextWindow) to \(maximumContextWindow) tokens.",
+                )
+            }
+        }
+        // A request that says nothing about pictures keeps what the endpoint
+        // was saved with, and pictures for one saved with nothing.
+        let takesImages = request.images ?? existing.map(EndpointStore.images) ?? true
+        return (title, base, model, models, key, request.contextWindow, takesImages)
+    }
+
+    /// Short and readable in a store id; no dashes, so it survives a path
+    /// or a query being written around it.
+    static func newID() -> String {
+        String(UUID().uuidString.replacingOccurrences(of: "-", with: "").prefix(10)).lowercased()
+    }
+
+    private static func isSpaceOrControl(_ scalar: Unicode.Scalar) -> Bool {
+        CharacterSet.whitespacesAndNewlines.contains(scalar) || CharacterSet.controlCharacters.contains(scalar)
+    }
+}
+
+extension AccountDesk {
+    /// Every saved endpoint, by id, so the list holds still as one is
+    /// edited.
+    public func endpoints() async -> [AgentEndpointSummary] {
+        var list: [AgentEndpointSummary] = []
+        for storeID in await store.providerIds().sorted() where CredentialProviderID.isEndpoint(storeID) {
+            guard let id = CredentialProviderID.endpointID(storeID),
+                  let credentials = try? await store.credentials(for: storeID)
+            else { continue }
+            list.append(EndpointStore.summary(id: id, credentials: credentials))
+        }
+        return list
+    }
+
+    /// Adds an endpoint, or replaces the one `request.id` names. A request
+    /// naming no key keeps the saved one.
+    public func save(_ request: AgentEndpointSaveRequest) async throws -> AgentEndpointSummary {
+        let id = request.id?.trimmingCharacters(in: .whitespaces) ?? EndpointStore.newID()
+        guard !id.isEmpty, id.count <= 64,
