diff --git a/Apelin/Interface/Settings/Accounts/EndpointFormController.swift b/Apelin/Interface/Settings/Accounts/EndpointFormController.swift
new file mode 100644
index 0000000..57ad431
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/EndpointFormController.swift
@@ -0,0 +1,372 @@
+import ApelinProtocol
+import UIKit
+
+/// Adds an OpenAI-compatible endpoint, or edits one: the name it is listed
+/// by, the address it answers on, its key, and the models it serves.
+///
+/// The key is written once and never read back, so an edit that leaves the
+/// field empty keeps the saved one: renaming an endpoint does not ask for
+/// its key again. The models come from the site itself when the reader asks
+/// for them, so a site that serves forty is not forty lines of typing.
+final class EndpointFormController: TableController {
+    var onFinish: (() -> Void)?
+
+    private enum Field: Hashable, CaseIterable {
+        case title
+        case baseURL
+        case apiKey
+        case models
+        case contextWindow
+        case images
+
+        var heading: String {
+            switch self {
+            case .title: String(localized: "Name")
+            case .baseURL: String(localized: "Address")
+            case .apiKey: String(localized: "API Key")
+            case .models: String(localized: "Models")
+            case .contextWindow: String(localized: "Context Window")
+            case .images: String(localized: "Image Input")
+            }
+        }
+
+        var placeholder: String {
+            // An address, a key and a list of IDs are not prose: they read
+            // the same in every language, so they stay out of the catalogue.
+            switch self {
+            case .title: String(localized: "The name this site is listed by")
+            case .baseURL: "https://…"
+            case .apiKey: "sk-…"
+            case .models: "gpt-4o, claude-sonnet-4-5"
+            case .contextWindow: "131072"
+            case .images: ""
+            }
+        }
+
+        /// The number of tokens a request may carry. Nil means the site's
+        /// own limit, which is what an endpoint had before this field.
+        var isTokens: Bool { self == .contextWindow }
+
+        /// A switch rather than a line to type on.
+        var isSwitch: Bool { self == .images }
+    }
+
+    private enum Row: Hashable {
+        case field(Field)
+        case fetch
+    }
+
+    private let account: AgentAccount?
+    private var fields: [Field: UITextField] = [:]
+    private var cells: [Field: UITableViewCell] = [:]
+    private var saving = false
+    private var fetching = false
+
+    private lazy var dataSource = TableDataSource<Field, Row, Row>(
+        tableView: tableView,
+        identifier: { $0 },
+    ) { [weak self] _, _, row in
+        self?.cell(for: row)
+    }
+
+    private lazy var saveItem = UIBarButtonItem(
+        title: String(localized: "Save"),
+        primaryAction: UIAction { [weak self] _ in self?.save() },
+    )
+
+    private lazy var fetchCell: UITableViewCell = {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        return cell
+    }()
+
+    /// Pictures on or off for this site. On unless the endpoint was saved
+    /// with them off, which is what a site serving a vision model wants.
+    private lazy var imagesSwitch: UISwitch = {
+        let toggle = UISwitch()
+        toggle.isOn = account?.endpoint?.images ?? true
+        toggle.accessibilityLabel = Field.images.heading
+        return toggle
+    }()
+
+    private lazy var imagesCell: UITableViewCell = {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        var content = UIListContentConfiguration.cell()
+        content.text = String(localized: "Read pictures")
+        cell.contentConfiguration = content
+        cell.accessoryView = imagesSwitch
+        cell.selectionStyle = .none
+        return cell
+    }()
+
+    /// `account` is the endpoint being edited; nil adds one.
+    init(account: AgentAccount? = nil) {
+        self.account = account
+        super.init(style: .insetGrouped)
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("init(coder:) is not used")
+    }
+
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        title = account == nil ? String(localized: "Add Endpoint") : String(localized: "Endpoint")
+        navigationItem.rightBarButtonItem = saveItem
+        tableView.keyboardDismissMode = .interactive
+        tableView.rowHeight = UITableView.automaticDimension
+        tableView.estimatedRowHeight = 52
+        dataSource.headerTitle = { $0.heading }
+        dataSource.footerTitle = { field in
+            switch field {
+            case .contextWindow:
+                String(localized: "The tokens this site takes in one request. Leave it empty to use the default.")
+            case .images:
+                String(localized: "Send pictures from this chat, and pictures tools take, to this site’s models. Turn it off for a site whose models take text only.")
+            default:
+                nil
+            }
+        }
+        for field in Field.allCases where !field.isSwitch {
+            let input = input(for: field)
+            input.accessibilityLabel = field.heading
+            input.returnKeyType = field == .contextWindow ? .done : .next
+            input.addAction(UIAction { [weak self] _ in self?.advance(from: field) }, for: .editingDidEndOnExit)
+            fields[field] = input
+            cells[field] = cell(containing: input)
+        }
+        updateFetchCell()
+        dataSource.update(Field.allCases.map { field -> (Field, [Row]) in
+            let rows: [Row] = [.field(field)]
+            return (field, field == .models ? rows + [.fetch] : rows)
+        })
+    }
+
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        guard account == nil else { return }
+        fields[.title]?.becomeFirstResponder()
+    }
+
+    private func input(for field: Field) -> UITextField {
+        let input = UITextField()
+        input.font = .preferredFont(forTextStyle: .body)
+        input.adjustsFontForContentSizeCategory = true
+        input.autocapitalizationType = field == .title ? .sentences : .none
+        input.autocorrectionType = .no
+        input.spellCheckingType = .no
+        input.smartDashesType = .no
+        input.smartQuotesType = .no
+        input.clearButtonMode = .whileEditing
+        input.isSecureTextEntry = field == .apiKey
+        input.textContentType = field == .baseURL ? .URL : (field == .apiKey ? .password : nil)
+        input.keyboardType = field == .baseURL ? .URL : (field.isTokens ? .numbersAndPunctuation : .asciiCapable)
+        input.placeholder = field.placeholder
+        switch field {
+        case .title:
+            input.text = account?.endpoint?.title ?? account?.title
+        case .baseURL:
+            input.text = account?.endpoint?.baseURL
+        case .apiKey:
+            input.text = nil
+            input.placeholder = account?.endpoint?.hasKey == true
+                ? String(localized: "Saved — leave empty to keep it")
+                : Field.apiKey.placeholder
+        case .models:
+            input.text = (account?.endpoint?.models ?? account?.models ?? []).joined(separator: ", ")
+        case .contextWindow:
+            input.text = account?.endpoint?.contextWindow.map(String.init)
+        case .images:
+            break
+        }
+        return input
+    }
+
+    private func cell(containing input: UIView) -> UITableViewCell {
+        let cell = UITableViewCell(style: .default, reuseIdentifier: nil)
+        cell.selectionStyle = .none
+        cell.isAccessibilityElement = false
+        input.translatesAutoresizingMaskIntoConstraints = false
+        cell.contentView.addSubview(input)
+        let margins = cell.contentView.layoutMarginsGuide
+        NSLayoutConstraint.activate([
+            input.leadingAnchor.constraint(equalTo: margins.leadingAnchor),
+            input.trailingAnchor.constraint(equalTo: margins.trailingAnchor),
+            input.topAnchor.constraint(equalTo: margins.topAnchor),
+            input.bottomAnchor.constraint(equalTo: margins.bottomAnchor),
+            cell.contentView.heightAnchor.constraint(greaterThanOrEqualToConstant: 52),
+        ])
+        return cell
+    }
+
+    private func cell(for row: Row) -> UITableViewCell? {
+        switch row {
+        case let .field(field): return field.isSwitch ? imagesCell : cells[field]
+        case .fetch: return fetchCell
+        }
+    }
+
+    private func trimmed(_ field: Field) -> String {
+        (fields[field]?.text ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    private var models: [String] {
+        (fields[.models]?.text ?? "")
+            .split(whereSeparator: { $0 == "," || $0.isNewline })
+            .map { $0.trimmingCharacters(in: .whitespaces) }
+            .filter { !$0.isEmpty }
+    }
+
+    private func advance(from field: Field) {
+        guard let index = Field.allCases.firstIndex(of: field),
+              index + 1 < Field.allCases.count,
+              let next = fields[Field.allCases[index + 1]]
+        else {
+            view.endEditing(true)
+            return
+        }
+        next.becomeFirstResponder()
+    }
+
+    // MARK: - Reading the site's models
+
+    private func updateFetchCell() {
+        var content = fetchCell.defaultContentConfiguration()
+        if fetching {
+            content.text = String(localized: "Fetching Models")
+            content.textProperties.color = .secondaryLabel
+            fetchCell.accessibilityTraits = [.button, .notEnabled]
+        } else {
+            content.text = String(localized: "Fetch Models")
+            content.textProperties.color = .tintColor
+            fetchCell.accessibilityTraits = .button
+        }
+        fetchCell.accessibilityLabel = content.text
+        fetchCell.contentConfiguration = content
+    }
+
+    private func fetchModels() {
+        guard !fetching, !saving else { return }
+        let address = trimmed(.baseURL)
+        guard !address.isEmpty else {
+            presentNotice(
+                title: "Address Needed",
+                message: String(localized: "Enter the endpoint’s address, then fetch its models."),
+            )
+            fields[.baseURL]?.becomeFirstResponder()
+            return
+        }
+        let key = trimmed(.apiKey)
+        let saved = account?.endpoint
+        // An edit that leaves the key field alone reads with the saved one,
+        // which only the worker has — and only for the address it was saved
+        // with, so a changed address asks for the key again.
+        let readsSavedKey = key.isEmpty && saved?.hasKey == true && address == (saved?.baseURL ?? "")
+        if key.isEmpty, !readsSavedKey {
+            presentNotice(
+                title: "Key Needed",
+                message: String(localized: "Enter the endpoint’s key so its model list can be read."),
+            )
+            fields[.apiKey]?.becomeFirstResponder()
+            return
+        }
+        view.endEditing(true)
+        fetching = true
+        updateFetchCell()
+        Task { [weak self] in
+            guard let self else { return }
+            defer {
+                fetching = false
+                updateFetchCell()
+            }
+            do {
+                let list: [String]
+                if readsSavedKey, let id = account?.id {
+                    list = try await ApelinService.app
+                        .agentModelList(provider: .openAICompatible, accountID: id).models
+                } else {
+                    list = try await EndpointModelProbe.models(address: address, apiKey: key)
+                }
+                fields[.models]?.text = list.joined(separator: ", ")
+                // Naming the host answers the question a list of odd-looking
+                // models raises: this is what that site serves, not what some
+                // other account left behind.
+                let host = URLComponents(string: address)?.host ?? address
+                presentNotice(
+                    title: "Models Found",
+                    message: String(localized: "\(list.count) models from \(host) are in the list now. Save to keep them."),
+                )
+            } catch {
+                presentNotice(title: "Unable to Fetch Models", message: error.readableMessage)
+            }
+        }
+    }
+
+    // MARK: - Saving
+
+    private func save() {
+        guard !saving else { return }
+        let title = trimmed(.title)
+        guard !title.isEmpty else {
+            presentNotice(title: "Name Needed", message: String(localized: "Give this endpoint a name to list it by."))
+            fields[.title]?.becomeFirstResponder()
+            return
+        }
+        let key = trimmed(.apiKey)
+        let windowText = trimmed(.contextWindow)
+        let window: Int?
+        if windowText.isEmpty {
+            window = nil
+        } else if let tokens = Int(windowText), (4_096 ... 4_000_000).contains(tokens) {
+            window = tokens
+        } else {
+            presentNotice(
+                title: "Context Window Needed",
+                message: String(localized: "Enter the window in tokens, from 4096 to 4000000, or leave it empty."),
+            )
+            fields[.contextWindow]?.becomeFirstResponder()
+            return
+        }
+        saving = true
+        saveItem.isEnabled = false
+        view.endEditing(true)
+        Task { [weak self] in
+            guard let self else { return }
+            do {
+                let saved = try await ApelinService.app.agentEndpointSave(AgentEndpointSaveRequest(
+                    id: account?.id,
+                    title: title,
+                    baseURL: trimmed(.baseURL),
+                    apiKey: key.isEmpty ? nil : key,
+                    defaultModel: account?.endpoint?.defaultModel,
+                    models: models,
+                    contextWindow: window,
+                    images: imagesSwitch.isOn,
+                ))
+                // A new endpoint arrives with its models on, so it is in the
+                // composer at once; one that already has picks keeps them.
+                let modelsKey = EnabledModels.key(provider: .openAICompatible, id: saved.id)
+                if EnabledModels.ids(for: modelsKey).isEmpty, !saved.models.isEmpty {
+                    EnabledModels.save(Set(saved.models), custom: [], hidden: [], for: modelsKey)
+                }
+                onFinish?()
+                dismiss(animated: true)
+            } catch {
+                saving = false
+                saveItem.isEnabled = true
+                presentNotice(title: "Unable to Save", message: error.readableMessage)
+            }
+        }
+    }
+
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard let row = dataSource.value(at: indexPath) else { return }
+        switch row {
+        case let .field(field):
+            fields[field]?.becomeFirstResponder()
+        case .fetch:
+            fetchModels()
+        }
+    }
+}
diff --git a/Apelin/Interface/Settings/Accounts/EndpointModelProbe.swift b/Apelin/Interface/Settings/Accounts/EndpointModelProbe.swift
new file mode 100644
index 0000000..a57dd18
--- /dev/null
+++ b/Apelin/Interface/Settings/Accounts/EndpointModelProbe.swift
@@ -0,0 +1,78 @@
+import ApelinProtocol
+import Foundation
+
+/// Reads the model list of an endpoint the form is still holding.
+///
+/// The account worker answers this for a saved endpoint, but the key it reads
+/// is the one in the keychain, and a key typed into this form is not there
+/// until Save. So this sends the one request the worker would have sent —
+/// `GET {address}/models`, the key as a bearer token — and parses the same
+/// shapes the provider's own catalogue is written in.
+enum EndpointModelProbe {
+    /// One endpoint keeps as many models as the worker accepts for it.
+    static let maximumModels = 64
+
+    static func models(address: String, apiKey: String) async throws -> [String] {
+        guard var components = URLComponents(string: address.trimmingCharacters(in: .whitespacesAndNewlines)),
+              let scheme = components.scheme?.lowercased(), scheme == "https" || scheme == "http",
+              components.host?.isEmpty == false
+        else {
+            throw ApelinError(.badRequest, String(localized: "Enter a valid HTTP or HTTPS address."))
+        }
+        // The form asks for the base URL a conversation would post to, so the
+        // list hangs off it: `/v1` stays, a bare host gains one, and a site
+        // with its own prefix keeps it.
+        let path = components.path.trimmingCharacters(in: CharacterSet(charactersIn: "/"))
+        components.path = "/" + (path.isEmpty ? "v1" : path) + "/models"
+        components.query = nil
+        components.fragment = nil
+        guard let url = components.url else {
+            throw ApelinError(.badRequest, String(localized: "Enter a valid HTTP or HTTPS address."))
+        }
+        var request = URLRequest(url: url, timeoutInterval: 20)
+        request.setValue("Bearer \(apiKey)", forHTTPHeaderField: "Authorization")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        let data: Data
+        let response: URLResponse
+        do {
+            (data, response) = try await URLSession.shared.data(for: request)
+        } catch is CancellationError {
+            throw CancellationError()
+        } catch {
+            throw ApelinError(
+                .unavailable,
+                String(localized: "Unable to reach the endpoint. Check the address and the key, then try again."),
+            )
+        }
+        guard let http = response as? HTTPURLResponse else {
+            throw ApelinError(.unavailable, String(localized: "The endpoint did not return a model list."))
+        }
+        guard http.statusCode == 200 else {
+            throw ApelinError(
+                .unavailable,
+                String(
+                    localized: "The endpoint answered \(http.statusCode). Check the address and the key, then try again.",
+                ),
+            )
+        }
+        guard data.count <= 4 * 1024 * 1024,
+              let root = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              let listed = (root["data"] ?? root["models"]) as? [[String: Any]]
+        else { throw ApelinError(.unavailable, String(localized: "The endpoint did not return a model list.")) }
+        let ids = listed.compactMap { ($0["id"] ?? $0["name"]) as? String }
+            .map { $0.hasPrefix("models/") ? String($0.dropFirst(7)) : $0 }
+            .filter { !$0.isEmpty && $0.count <= 256 }
+        // The site's own order, kept: a panel groups its list by what it
+        // sells, so the models of the thing the reader came for sit
+        // together instead of being scattered by the alphabet.
+        var seen = Set<String>()
+        let unique = ids.filter { seen.insert($0).inserted }
+        guard !unique.isEmpty else {
+            throw ApelinError(
+                .unavailable,
+                String(localized: "The endpoint lists no models. Add one by hand, or check that the address is the one it serves."),
+            )
+        }
+        return Array(unique.prefix(maximumModels))
+    }
+}
