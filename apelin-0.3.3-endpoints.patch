diff --git a/Apelin/Interface/DesignTokens/MinisSkin.swift b/Apelin/Interface/DesignTokens/MinisSkin.swift
new file mode 100644
index 0000000..15f8c08
--- /dev/null
+++ b/Apelin/Interface/DesignTokens/MinisSkin.swift
@@ -0,0 +1,259 @@
+import UIKit
+
+/// Minis' skin, in one place: the grounds a screen is built on, the card a
+/// group of rows sits on, the fill a bubble or a tool call takes, and the
+/// gradient tile a row leads with. Every number here is Minis' own, so the
+/// two apps read as one hand: a white page, a white card on a grey ground,
+/// 20 pt corners, one blue.
+enum MinisPalette {
+    /// The page itself: white in the light, black in the dark. A list of
+    /// cards sits on it with nothing between them but air.
+    static let canvas = UIColor(light: UIColor(hex: 0xFFFFFF), dark: .black)
+
+    /// The ground a grouped list is inset from, one step under the cards.
+    static let ground = UIColor(light: UIColor(hex: 0xF6F6F7), dark: UIColor(hex: 0x0B0B0C))
+
+    /// A card: a row, a group of rows, the composer.
+    static let card = UIColor(light: UIColor(hex: 0xFFFFFF), dark: UIColor(hex: 0x1C1C1E))
+
+    /// The hairline a card keeps against a page of its own colour.
+    static let cardStroke = UIColor(light: UIColor.black.withAlphaComponent(0.06), dark: UIColor.white.withAlphaComponent(0.08))
+
+    /// A user's message, a tool call's pill: the neutral the accent stays
+    /// out of, so the blue is left for what acts (Minis' own choice).
+    static let fill = UIColor(light: UIColor(hex: 0xEFEFF0), dark: UIColor(hex: 0x2C2C2E))
+
+    /// A fill inside a fill: an attachment's ground on a bubble's.
+    static let fillSecondary = UIColor(light: UIColor(hex: 0xF7F7F8), dark: UIColor(hex: 0x232325))
+
+    /// The one accent: the system's blue, in both modes and on every
+    /// system, because that is what a Minis row's count, a Send and a
+    /// selected row are drawn in.
+    static let accent = UIColor.systemBlue
+
+    /// A wash of the accent, for a selected row's ground.
+    static let accentWash = UIColor { trait in
+        UIColor.systemBlue.resolvedColor(with: trait).withAlphaComponent(trait.userInterfaceStyle == .dark ? 0.22 : 0.10)
+    }
+
+    /// The pairs a row's icon tile is filled with, top leading to bottom
+    /// trailing. Six, so a list of rows never reads as one colour.
+    static let tilePairs: [(UIColor, UIColor)] = [
+        (UIColor(hex: 0x4FC3F7), UIColor(hex: 0x2E8FE0)), // sky
+        (UIColor(hex: 0xA98BFF), UIColor(hex: 0x6C5CE7)), // violet
+        (UIColor(hex: 0xFF9A8B), UIColor(hex: 0xF2617E)), // coral
+        (UIColor(hex: 0xFFC46B), UIColor(hex: 0xF0903A)), // amber
+        (UIColor(hex: 0x6BE3B8), UIColor(hex: 0x2FAE86)), // mint
+        (UIColor(hex: 0xFFA8D2), UIColor(hex: 0xE85C9B)), // rose
+    ]
+
+    /// The pair a seed keeps: the same conversation, or the same settings
+    /// row, keeps its colour across launches and reorders.
+    static func tilePair(for seed: String) -> (UIColor, UIColor) {
+        var hash: UInt64 = 0x811C_9DC5
+        for scalar in seed.unicodeScalars {
+            hash = (hash ^ UInt64(scalar.value)) &* 0x0100_0000_01B3
+        }
+        return tilePairs[Int(hash % UInt64(tilePairs.count))]
+    }
+}
+
+/// The measurements the skin is built on, so a change here moves every
+/// screen that took them.
+enum MinisMetrics {
+    /// A card's corners: a row, a group, the composer's outer ground.
+    static let cardRadius: CGFloat = 20
+    /// The composer's card, rounder than a row because it is a place to
+    /// type rather than a place to read.
+    static let composerRadius: CGFloat = 26
+    /// A message bubble: half again as round as the app's old 12.
+    static let bubbleRadius: CGFloat = 18
+    /// A tool call's pill: the row's height over two.
+    static let pillHeight: CGFloat = 28
+    /// Between the page's edge and a card.
+    static let gutter: CGFloat = 16
+    /// Inside a card, between its edge and what it holds.
+    static let cardInset: CGFloat = 16
+    /// A row's icon tile and its corners.
+    static let tileSize: CGFloat = 30
+    static let tileRadius: CGFloat = 9
+    /// The shortest a row gets.
+    static let rowHeight: CGFloat = 56
+    /// Between a card and the next section's heading.
+    static let sectionSpacing: CGFloat = 22
+}
+
+/// A row's icon: a small rounded square of gradient with a white glyph on
+/// it, the one thing that gives a list of conversations or settings its
+/// colour.
+final class MinisIconTile: UIView {
+    private let gradient = CAGradientLayer()
+    private let glyph = UIImageView()
+
+    init(symbol: String, seed: String) {
+        super.init(frame: CGRect(x: 0, y: 0, width: MinisMetrics.tileSize, height: MinisMetrics.tileSize))
+        let pair = MinisPalette.tilePair(for: seed)
+        gradient.colors = [pair.0.cgColor, pair.1.cgColor]
+        gradient.startPoint = CGPoint(x: 0, y: 0)
+        gradient.endPoint = CGPoint(x: 1, y: 1)
+        gradient.cornerRadius = MinisMetrics.tileRadius
+        gradient.cornerCurve = .continuous
+        layer.addSublayer(gradient)
+
+        glyph.image = UIImage(
+            systemName: symbol,
+            withConfiguration: UIImage.SymbolConfiguration(pointSize: 13, weight: .semibold),
+        )
+        glyph.tintColor = .white
+        glyph.contentMode = .center
+        addSubview(glyph)
+
+        isAccessibilityElement = false
+        translatesAutoresizingMaskIntoConstraints = false
+        NSLayoutConstraint.activate([
+            widthAnchor.constraint(equalToConstant: MinisMetrics.tileSize),
+            heightAnchor.constraint(equalToConstant: MinisMetrics.tileSize),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("Use init(symbol:seed:)")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        gradient.frame = bounds
+        glyph.frame = bounds
+    }
+}
+
+/// A card: what a group of rows, or a single row, is drawn on. White on the
+/// page's ground, hairline round the edge, and — only when it floats over
+/// content rather than over the page — a soft shadow.
+final class MinisCardView: UIView {
+    init(radius: CGFloat = MinisMetrics.cardRadius, floats: Bool = false) {
+        super.init(frame: .zero)
+        backgroundColor = MinisPalette.card
+        layer.cornerRadius = radius
+        layer.cornerCurve = .continuous
+        layer.borderWidth = 1 / max(traitCollection.displayScale, 1)
+        layer.borderColor = MinisPalette.cardStroke.resolvedColor(with: traitCollection).cgColor
+        if floats {
+            layer.shadowColor = UIColor.black.cgColor
+            layer.shadowOpacity = 0.07
+            layer.shadowRadius = 14
+            layer.shadowOffset = CGSize(width: 0, height: 6)
+        }
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("Use init(radius:floats:)")
+    }
+
+    override func traitCollectionDidChange(_ previous: UITraitCollection?) {
+        super.traitCollectionDidChange(previous)
+        layer.borderColor = MinisPalette.cardStroke.resolvedColor(with: traitCollection).cgColor
+    }
+}
+
+/// A tool call as Minis draws one: a pill on the page, a glyph, the call's/// name, and how long it took — not a full-width band between two rules.
+final class MinisPillView: UIView {
+    private let glyph = UIImageView()
+    private let label = UILabel()
+    private let duration = UILabel()
+
+    init() {
+        super.init(frame: .zero)
+        backgroundColor = MinisPalette.fill
+        layer.cornerRadius = MinisMetrics.pillHeight / 2
+        layer.cornerCurve = .continuous
+
+        glyph.image = UIImage(
+            systemName: "square.fill",
+            withConfiguration: UIImage.SymbolConfiguration(pointSize: 10, weight: .semibold),
+        )
+        glyph.tintColor = UIColor(hex: 0x34C759)
+        glyph.contentMode = .center
+        addSubview(glyph)
+
+        label.font = .preferredFont(forTextStyle: .footnote)
+        label.textColor = .label
+        label.lineBreakMode = .byTruncatingTail
+        addSubview(label)
+
+        duration.font = .monospacedDigitSystemFont(ofSize: UIFont.preferredFont(forTextStyle: .caption2).pointSize, weight: .regular)
+        duration.textColor = .tertiaryLabel
+        duration.setContentHuggingPriority(.required, for: .horizontal)
+        addSubview(duration)
+
+        translatesAutoresizingMaskIntoConstraints = false
+        glyph.translatesAutoresizingMaskIntoConstraints = false
+        label.translatesAutoresizingMaskIntoConstraints = false
+        duration.translatesAutoresizingMaskIntoConstraints = false
+        NSLayoutConstraint.activate([
+            heightAnchor.constraint(equalToConstant: MinisMetrics.pillHeight),
+            glyph.leadingAnchor.constraint(equalTo: leadingAnchor, constant: 10),
+            glyph.centerYAnchor.constraint(equalTo: centerYAnchor),
+            glyph.widthAnchor.constraint(equalToConstant: 14),
+            label.leadingAnchor.constraint(equalTo: glyph.trailingAnchor, constant: 6),
+            label.centerYAnchor.constraint(equalTo: centerYAnchor),
+            duration.leadingAnchor.constraint(equalTo: label.trailingAnchor, constant: 8),
+            duration.trailingAnchor.constraint(equalTo: trailingAnchor, constant: -12),
+            duration.centerYAnchor.constraint(equalTo: centerYAnchor),
+        ])
+    }
+
+    @available(*, unavailable)
+    required init?(coder _: NSCoder) {
+        fatalError("Use init()")
+    }
+
+    func show(_ text: String, durationText: String?) {
+        label.text = text
+        duration.text = durationText
+        duration.isHidden = durationText == nil
+        isAccessibilityElement = true
+        accessibilityLabel = text
+        accessibilityValue = durationText
+    }
+}
+
+/// The same tile, drawn into an image: a list configuration
+/// (`UIListContentConfiguration`) takes an image, not a view, so every
+/// grouped settings row gets its colour this way.
+enum MinisIconTileImage {
+    static func make(symbol: String, seed: String, size: CGFloat = MinisMetrics.tileSize) -> UIImage? {
+        let pair = MinisPalette.tilePair(for: seed)
+        let renderer = UIGraphicsImageRenderer(size: CGSize(width: size, height: size))
+        return renderer.image { context in
+            let rect = CGRect(x: 0, y: 0, width: size, height: size)
+            let radius = size * MinisMetrics.tileRadius / MinisMetrics.tileSize
+            UIBezierPath(roundedRect: rect, cornerRadius: radius).addClip()
+            let space = CGColorSpaceCreateDeviceRGB()
+            if let gradient = CGGradient(
+                colorsSpace: space,
+                colors: [pair.0.cgColor, pair.1.cgColor] as CFArray,
+                locations: [0, 1],
+            ) {
+                context.cgContext.drawLinearGradient(
+                    gradient,
+                    start: .zero,
+                    end: CGPoint(x: size, y: size),
+                    options: [],
+                )
+            }
+            let configuration = UIImage.SymbolConfiguration(pointSize: (size * 0.46).rounded(), weight: .semibold)
+                .applying(UIImage.SymbolConfiguration(paletteColors: [.white]))
+            guard let glyph = UIImage(systemName: symbol, withConfiguration: configuration)?
+                .withRenderingMode(.alwaysOriginal) else { return }
+            glyph.draw(in: CGRect(
+                x: (size - glyph.size.width) / 2,
+                y: (size - glyph.size.height) / 2,
+                width: glyph.size.width,
+                height: glyph.size.height,
+            ))
+        }
+    }
+}
