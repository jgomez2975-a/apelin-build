diff --git a/build-skin.sh b/build-skin.sh
new file mode 100644
index 0000000..c7e33d6
--- /dev/null
+++ b/build-skin.sh
@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+# Builds the Minis-skinned Apelin and puts the packages in dist/.
+# Run it on a Mac with Xcode installed (the project tracks the iOS 27 SDK).
+#
+#   ./build-skin.sh                 # both flavours + every extension
+#   ./build-skin.sh roothide        # only the rootHide layout
+#   BUILD_NUMBER=99 ./build-skin.sh # pin the build number
+set -euo pipefail
+
+FLAVOR="${1:-all}"
+BUILD_NUMBER="${BUILD_NUMBER:-$(git rev-list --count HEAD 2>/dev/null || echo 1)}"
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$ROOT"
+
+say() { printf '\n\033[1m▸ %s\033[0m\n' "$*"; }
+die() { printf '\n\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
+
+say "Checking the toolchain"
+[[ "$(uname -s)" == "Darwin" ]] || die "This needs macOS — xcodebuild and the iOS SDK live there."
+command -v xcodebuild >/dev/null || die "xcodebuild is missing. Install Xcode."
+command -v make       >/dev/null || die "make is missing."
+command -v dpkg-deb   >/dev/null || die "dpkg-deb is missing.  brew install dpkg"
+command -v ldid       >/dev/null || die "ldid is missing.      brew install ldid"
+command -v zstd       >/dev/null || true
+xcodebuild -version | head -2
+echo "build number: $BUILD_NUMBER"
+
+say "Host tests (make harness)"
+make harness
+
+say "Static gates (make check)"
+make check
+
+case "$FLAVOR" in
+  all)      say "Packaging both flavours and every extension (make deb-all)"
+            make deb-all BUILD_NUMBER="$BUILD_NUMBER" ;;
+  roothide) say "Packaging rootHide (make deb-roothide)"
+            make deb-roothide BUILD_NUMBER="$BUILD_NUMBER" ;;
+  rootless) say "Packaging rootless (make deb-rootless)"
+            make deb-rootless BUILD_NUMBER="$BUILD_NUMBER" ;;
+  *)        die "FLAVOR must be all, roothide or rootless — got '$FLAVOR'" ;;
+esac
+
+say "Collecting into dist/"
+mkdir -p dist
+shopt -s nullglob
+debs=(build/Packages/*.deb)
+(( ${#debs[@]} > 0 )) || die "No .deb came out of the build."
+cp -f "${debs[@]}" dist/
+cp -f build/Packages/*_Templates.tar.zst dist/ 2>/dev/null || true
+cd dist
+shasum -a 256 ./*.deb > SHA256SUMS
+cat SHA256SUMS
+
+cat <<'EOF'
+
+Install on a jailbroken device over SSH (root password: alpine by default):
+
+  scp dist/wiki.qaq.apelin_*.deb root@<device-ip>:/var/mobile/
+  ssh root@<device-ip> 'dpkg -i /var/mobile/wiki.qaq.apelin_*.deb; sbreload'
+
+Or, from the repo, with the device reachable:
+
+  make install DEVICE_HOST=<device-ip> DEVICE_PORT=22 FLAVOR=roothide
+
+Needs iOS/iPadOS 16+, A12 or later, Irisin >= 4.7.3, icli >= 0.10.0.
+EOF
