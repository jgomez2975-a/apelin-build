+            try await store.store(credentials, for: storeID)
+        } catch {
+            throw ApelinError(.internal, "Unable to save the endpoint: \(error.localizedDescription). Try again.")
+        }
+        return EndpointStore.summary(id: id, credentials: credentials)
+    }
+
+    public func removeEndpoint(id: String) async throws {
+        do {
+            try await store.remove(CredentialProviderID.endpoint(id))
+        } catch {
+            throw ApelinError(.internal, "Unable to remove the endpoint: \(error.localizedDescription). Try again.")
+        }
+    }
+}
