+        credentials.extras[AgentSignInField.baseURL.rawValue] = .string(accepted.baseURL)
+        credentials.extras[EndpointStore.titleExtra] = .string(accepted.title)
+        credentials.extras[EndpointStore.modelsExtra] = .string(accepted.models.joined(separator: ","))
+        if let model = accepted.model {
+            credentials.extras[AgentSignInField.defaultModel.rawValue] = .string(model)
+        } else {
+            credentials.extras.removeValue(forKey: AgentSignInField.defaultModel.rawValue)
+        }
+        if let window = accepted.contextWindow {
+            credentials.extras[EndpointStore.contextWindowExtra] = .string(String(window))
+        } else {
+            credentials.extras.removeValue(forKey: EndpointStore.contextWindowExtra)
+        }
